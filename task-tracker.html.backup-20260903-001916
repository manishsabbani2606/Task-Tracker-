<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daily Work Report Tracker</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-1: #eef1fb;
    --bg-2: #f7f5ff;
    --card: #ffffff;
    --text: #1c1f2e;
    --muted: #6b7280;
    --border: #e7e8f1;
    --accent: #6d5bf5;
    --accent-2: #8b7ffb;
    --accent-hover: #5a48e0;
    --accent-soft: #efecff;
    --danger: #e5484d;
    --danger-soft: #fdecec;
    --done: #17a673;
    --done-soft: #e7f9f2;
    --shadow-sm: 0 1px 2px rgba(23, 20, 60, 0.04), 0 1px 1px rgba(23, 20, 60, 0.03);
    --shadow-md: 0 10px 24px -12px rgba(76, 60, 190, 0.18), 0 2px 8px -2px rgba(76, 60, 190, 0.08);
    --shadow-lg: 0 20px 40px -18px rgba(76, 60, 190, 0.28);
    --radius: 16px;
  }
  * { box-sizing: border-box; }
  ::selection { background: var(--accent-soft); color: var(--accent-hover); }
  body {
    margin: 0;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background:
      radial-gradient(1200px 500px at 10% -10%, #e4e0ff 0%, transparent 55%),
      radial-gradient(900px 500px at 100% 0%, #dceafe 0%, transparent 50%),
      linear-gradient(180deg, var(--bg-1), var(--bg-2) 60%);
    background-attachment: fixed;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 20px 70px;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    gap: 16px;
  }
  .header-icon {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    box-shadow: var(--shadow-md);
    flex-shrink: 0;
  }
  .header-text { display: flex; align-items: center; gap: 14px; }
  h1 {
    font-size: 24px;
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, #201c3f, #4a3f8f);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .subtitle { color: var(--muted); font-size: 13.5px; margin-top: 3px; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px 24px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    animation: rise 0.45s ease both;
  }
  .card:hover { box-shadow: var(--shadow-md); }
  .card h2 {
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-hover);
    font-weight: 700;
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card h2::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: inline-block;
  }
  .entry-row {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
  }
  input[type="text"], select, input[type="date"] {
    font-size: 14px;
    padding: 11px 13px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: inherit;
    background: #fbfbfe;
    color: var(--text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    outline: none;
  }
  input[type="text"]:hover, select:hover, input[type="date"]:hover { border-color: #cfd1e6; }
  input[type="text"]:focus, select:focus, input[type="date"]:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    background: #fff;
  }
  .entry-row input[type="text"] { flex: 1; }
  .entry-row select { width: 140px; cursor: pointer; }
  .entry-row input[type="number"] { width: 90px; }
  button {
    cursor: pointer;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    padding: 11px 18px;
    font-family: inherit;
    transition: transform 0.12s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  button:active { transform: scale(0.97); }
  .btn-primary {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    box-shadow: var(--shadow-md);
  }
  .btn-primary:hover { background: linear-gradient(135deg, var(--accent-hover), var(--accent)); box-shadow: var(--shadow-lg); transform: translateY(-1px); }
  .btn-secondary { background: var(--accent-soft); color: var(--accent-hover); }
  .btn-secondary:hover { background: #e2ddff; }
  .btn-danger {
    background: transparent;
    color: var(--muted);
    padding: 6px 9px;
    border-radius: 8px;
    font-size: 13px;
    opacity: 0;
  }
  ul.task-list li:hover .btn-danger { opacity: 1; }
  .btn-danger:hover { background: var(--danger-soft); color: var(--danger); }
  .date-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .date-nav button.btn-secondary { padding: 8px 14px; font-size: 15px; line-height: 1; }
  .date-nav .today-label {
    font-weight: 700;
    font-size: 15.5px;
    flex: 1;
    text-align: center;
    color: var(--text);
  }
  .clock-row {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    padding: 14px 16px;
    margin-bottom: 16px;
    background: #fbfbff;
    border: 1px solid var(--border);
    border-radius: 12px;
    flex-wrap: wrap;
  }
  .clock-field { display: flex; flex-direction: column; gap: 5px; }
  .clock-field label {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .clock-field-row { display: flex; gap: 8px; align-items: center; }
  .btn-clock {
    font-size: 12.5px;
    padding: 9px 13px;
    white-space: nowrap;
    box-shadow: none;
  }
  .btn-clock-in { background: var(--done-soft); color: var(--done); }
  .btn-clock-in:hover { background: #d3f3e6; }
  .btn-clock-out { background: var(--danger-soft); color: var(--danger); }
  .btn-clock-out:hover { background: #fbdada; }
  input[type="time"] {
    font-size: 14px;
    padding: 9px 11px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: inherit;
    background: #fbfbfe;
    color: var(--text);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  input[type="time"]:hover { border-color: #cfd1e6; }
  input[type="time"]:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    background: #fff;
  }
  .hours-badge {
    margin-left: auto;
    font-size: 13.5px;
    font-weight: 700;
    padding: 9px 16px;
    border-radius: 20px;
    background: var(--done-soft);
    color: var(--done);
    white-space: nowrap;
  }
  .submit-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .submit-status {
    font-size: 13px;
    font-weight: 600;
    color: var(--done);
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .submit-status.show { opacity: 1; transform: translateX(0); }
  #submitDayBtn.is-submitted {
    background: var(--done-soft);
    color: var(--done);
    box-shadow: none;
  }
  #submitDayBtn.is-submitted:hover { background: #d3f3e6; }
  input:disabled, select:disabled, button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  button:disabled:hover, button:disabled:active { transform: none; box-shadow: none; }
  .week-total {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 18px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent-soft), #e8f6ff);
    color: var(--accent-hover);
    font-weight: 700;
    font-size: 14px;
    margin-top: 14px;
  }
  .week-total-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .week-total span.value { font-size: 18px; }
  .day-block .day-hours {
    float: right;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--done);
    background: var(--done-soft);
    padding: 2px 9px;
    border-radius: 20px;
  }
  ul.task-list { list-style: none; margin: 0; padding: 0; }
  ul.task-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 4px;
    border-bottom: 1px solid var(--border);
    animation: rise 0.3s ease both;
    transition: background 0.15s ease;
    border-radius: 8px;
  }
  ul.task-list li:hover { background: #faf9ff; }
  ul.task-list li:last-child { border-bottom: none; }
  ul.task-list input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 19px;
    height: 19px;
    border-radius: 6px;
    border: 1.5px solid #d3d5e6;
    background: #fff;
    cursor: pointer;
    flex-shrink: 0;
    position: relative;
    transition: all 0.15s ease;
  }
  ul.task-list input[type="checkbox"]:hover { border-color: var(--accent); }
  ul.task-list input[type="checkbox"]:checked {
    background: linear-gradient(135deg, var(--done), #19b881);
    border-color: transparent;
  }
  ul.task-list input[type="checkbox"]:checked::after {
    content: "";
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 9px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .task-text { flex: 1; font-size: 14.5px; transition: color 0.15s ease; }
  .task-text.done { text-decoration: line-through; color: var(--muted); }
  .tag {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    background: var(--accent-soft);
    color: var(--accent-hover);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .tag[data-cat="Incident"] { background: #fdecec; color: #c0343a; }
  .tag[data-cat="Service Request"] { background: #e3f3fd; color: #0a75b5; }
  .tag[data-cat="Support Ticket"] { background: #e3f7f4; color: #0b8f7d; }
  .tag[data-cat="Meeting"] { background: #fdf0e3; color: #b5650a; }
  .tag[data-cat="Project"] { background: #ecebff; color: #5a48e0; }
  .tag[data-cat="Learning"] { background: #eafbe7; color: #22883e; }
  .tag[data-cat="Admin"] { background: #eef0f4; color: #4a5568; }
  .tag[data-cat="Work"] { background: var(--accent-soft); color: var(--accent-hover); }
  .tag[data-cat="Other"] { background: #f1f1f5; color: #5b5e6e; }
  .ticket-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 6px;
    background: #eef0f6;
    color: #4a5568;
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .prio-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .prio-tag[data-prio="Low"] { background: #eef0f4; color: #5b6472; }
  .prio-tag[data-prio="Medium"] { background: #e7eefc; color: #2b5cc4; }
  .prio-tag[data-prio="High"] { background: #fdeede; color: #b5650a; }
  .prio-tag[data-prio="Urgent"] { background: #fdecec; color: #d13438; }
  .status-select {
    font-size: 11.5px;
    font-weight: 700;
    padding: 6px 8px;
    border-radius: 8px;
    border: 1.5px solid var(--border);
    background: #fbfbfe;
    color: var(--text);
    cursor: pointer;
    flex-shrink: 0;
    outline: none;
    font-family: inherit;
  }
  .status-select[data-status="Open"] { color: #5b6472; }
  .status-select[data-status="In Progress"] { color: #b5650a; background: #fdf6ec; border-color: #f0dcc0; }
  .status-select[data-status="Resolved"] { color: var(--done); background: var(--done-soft); border-color: #bfe9d8; }
  .duration-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    background: var(--done-soft);
    color: var(--done);
    white-space: nowrap;
  }
  .task-time-badge {
    margin-left: auto;
    font-size: 13.5px;
    font-weight: 700;
    padding: 9px 16px;
    border-radius: 20px;
    background: var(--accent-soft);
    color: var(--accent-hover);
    white-space: nowrap;
  }
  .task-time-row {
    display: flex;
    justify-content: flex-end;
    margin: -6px 0 14px;
  }
  .empty {
    color: var(--muted);
    font-size: 13.5px;
    font-style: italic;
    padding: 22px 0;
    text-align: center;
  }
  .week-controls {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .week-controls label { font-size: 13px; color: var(--muted); font-weight: 500; }
  .day-block {
    margin-bottom: 14px;
    padding: 14px 16px;
    background: #fbfbff;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .day-block h3 {
    font-size: 13px;
    margin: 0 0 8px;
    color: var(--accent-hover);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .day-block ul { list-style: none; margin: 0; padding: 0; }
  .day-block li { font-size: 13.5px; padding: 4px 0; color: var(--text); }
  .day-block .status { color: var(--muted); font-size: 12px; font-style: italic; }
  footer {
    text-align: center;
    color: var(--muted);
    font-size: 12px;
    margin-top: 36px;
    padding-top: 20px;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .entry-row input[type="number"] {
    font-size: 14px;
    padding: 11px 13px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: inherit;
    background: #fbfbfe;
    color: var(--text);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .entry-row input[type="number"]:hover { border-color: #cfd1e6; }
  .entry-row input[type="number"]:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    background: #fff;
  }
  #taskTicket { flex: 0 0 190px; }
  .theme-toggle {
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--text);
    width: 42px;
    height: 42px;
    border-radius: 12px;
    font-size: 18px;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    flex-shrink: 0;
  }
  .theme-toggle:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }
  .backup-note { color: var(--muted); font-size: 13px; margin: 0 0 12px; line-height: 1.55; }
  .backup-controls { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .save-indicator {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--done);
    opacity: 0;
    transition: opacity 0.2s ease;
    margin-left: 4px;
  }
  .save-indicator.show { opacity: 1; }
  .autosave-row {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px dashed var(--border);
    flex-wrap: wrap;
  }
  .autosave-status { font-size: 12.5px; color: var(--muted); font-weight: 600; }
  .autosave-status.on { color: var(--done); }
  .autosave-status.on::before { content: "● "; }

  /* ---- Dark mode ---- */
  :root[data-theme="dark"] {
    --bg-1: #14151f;
    --bg-2: #191a26;
    --card: #1e2030;
    --text: #e6e7ef;
    --muted: #9a9db2;
    --border: #2c2e42;
    --accent: #8b7ffb;
    --accent-2: #a99cff;
    --accent-hover: #b3a7ff;
    --accent-soft: #2a2846;
    --danger: #f2686d;
    --danger-soft: #3a2226;
    --done: #35c99a;
    --done-soft: #14302a;
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.35);
    --shadow-md: 0 10px 24px -12px rgba(0, 0, 0, 0.55);
    --shadow-lg: 0 20px 40px -18px rgba(0, 0, 0, 0.65);
  }
  :root[data-theme="dark"] body {
    background:
      radial-gradient(1200px 500px at 10% -10%, #241f4d 0%, transparent 55%),
      radial-gradient(900px 500px at 100% 0%, #16283f 0%, transparent 50%),
      linear-gradient(180deg, var(--bg-1), var(--bg-2) 60%);
  }
  :root[data-theme="dark"] h1 {
    background: linear-gradient(90deg, #eceaff, #b3a7ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  :root[data-theme="dark"] input[type="text"],
  :root[data-theme="dark"] select,
  :root[data-theme="dark"] input[type="date"],
  :root[data-theme="dark"] input[type="time"],
  :root[data-theme="dark"] .entry-row input[type="number"],
  :root[data-theme="dark"] .status-select {
    background: #262838;
    color: var(--text);
  }
  :root[data-theme="dark"] input[type="date"]::-webkit-calendar-picker-indicator,
  :root[data-theme="dark"] input[type="time"]::-webkit-calendar-picker-indicator {
    filter: invert(0.8);
  }
  :root[data-theme="dark"] .clock-row,
  :root[data-theme="dark"] .day-block { background: #191b28; }
  :root[data-theme="dark"] ul.task-list li:hover { background: #23253a; }

  @media (max-width: 560px) {
    .entry-row { flex-wrap: wrap; }
    .entry-row select, .entry-row .btn-primary, #taskTicket { width: 100%; flex: 1 1 100%; }
    .header-text { gap: 10px; }
    h1 { font-size: 20px; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="header-text">
      <div>
        <h1>Daily Work Report Tracker</h1>
        <div class="subtitle">Log your daily tasks and time spent, then export a weekly report for your manager.</div>
      </div>
    </div>
    <button class="theme-toggle" id="themeToggle" title="Toggle dark mode" aria-label="Toggle dark mode">🌙</button>
  </header>

  <div class="card">
    <h2>Log a task</h2>
    <div class="entry-row">
      <input type="text" id="taskInput" placeholder="What did you work on?" autocomplete="off">
      <input type="text" id="taskTicket" placeholder="Ticket # (optional)" autocomplete="off">
    </div>
    <div class="entry-row">
      <select id="taskCategory">
        <option value="Incident">Incident</option>
        <option value="Service Request">Service Request</option>
        <option value="Support Ticket" selected>Support Ticket</option>
        <option value="Work">Work</option>
        <option value="Meeting">Meeting</option>
        <option value="Project">Project</option>
        <option value="Learning">Learning</option>
        <option value="Admin">Admin</option>
        <option value="Other">Other</option>
      </select>
      <select id="taskPriority">
        <option value="Low">Low</option>
        <option value="Medium" selected>Medium</option>
        <option value="High">High</option>
        <option value="Urgent">Urgent</option>
      </select>
      <input type="number" id="taskMinutes" placeholder="Mins" min="0" step="5">
      <button class="btn-primary" id="addBtn">Add</button>
    </div>
  </div>

  <div class="card">
    <h2>Day</h2>
    <div class="date-nav">
      <button class="btn-secondary" id="prevDay">&larr;</button>
      <span class="today-label" id="dayLabel"></span>
      <button class="btn-secondary" id="nextDay">&rarr;</button>
      <button class="btn-secondary" id="jumpToday">Today</button>
    </div>

    <div class="clock-row">
      <div class="clock-field">
        <label for="clockIn">Clock in</label>
        <div class="clock-field-row">
          <input type="time" id="clockIn">
          <button class="btn-clock btn-clock-in" id="clockInBtn">Clock In</button>
        </div>
      </div>
      <div class="clock-field">
        <label for="clockOut">Clock out</label>
        <div class="clock-field-row">
          <input type="time" id="clockOut">
          <button class="btn-clock btn-clock-out" id="clockOutBtn">Clock Out</button>
        </div>
      </div>
      <div class="hours-badge" id="hoursBadge">0h 0m</div>
    </div>

    <div class="submit-row">
      <button class="btn-primary" id="submitDayBtn">Submit</button>
      <span class="submit-status" id="submitStatus"></span>
    </div>

    <ul class="task-list" id="taskList"></ul>
    <div class="empty" id="emptyMsg" style="display:none;">No tasks logged for this day yet.</div>
    <div class="task-time-row">
      <div class="task-time-badge" id="taskTimeBadge">Task time: 0h 0m</div>
    </div>
  </div>

  <div class="card">
    <h2>Data &amp; backup</h2>
    <p class="backup-note">Your entries auto-save in this browser automatically — clock in today and it's here tomorrow. Keep a backup file in OneDrive so nothing is ever lost and you can open your history on another computer.</p>
    <div class="backup-controls">
      <button class="btn-primary" id="saveFileBtn">Save backup file</button>
      <button class="btn-secondary" id="loadFileBtn">Restore from file</button>
      <input type="file" id="importInput" accept="application/json,.json" hidden>
      <span class="save-indicator" id="saveIndicator"></span>
    </div>
    <div class="autosave-row" id="autosaveRow" hidden>
      <button class="btn-secondary" id="linkFileBtn">Turn on auto-save to file</button>
      <span class="autosave-status" id="autosaveStatus">Auto-save off</span>
    </div>
  </div>

  <div class="card">
    <h2>Weekly report</h2>
    <div class="week-controls">
      <label for="weekStart">Week starting</label>
      <input type="date" id="weekStart">
      <button class="btn-secondary" id="previewWeek">Preview</button>
      <button class="btn-primary" id="exportPdf">Export as PDF</button>
    </div>
    <div class="week-total" id="weekTotal" style="display:none;"></div>
    <div id="weekPreview" style="margin-top:16px;"></div>
  </div>

  <footer>Data is stored locally in this browser. Nothing is sent anywhere.</footer>
</div>

<script>
const STORAGE_KEY = "taskTrackerEntries";

function loadData() {
  try {
    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
  } catch (e) {
    return {};
  }
}
function saveData(data) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  showSaved();
  scheduleFileSave();
}

function fmtDate(d) {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}
function fmtLabel(d) {
  return d.toLocaleDateString(undefined, { weekday: "long", year: "numeric", month: "long", day: "numeric" });
}

// Ensures data[key] is in the { tasks: [], clockIn, clockOut } shape,
// migrating any older array-only entries in place.
function getDayData(key) {
  let d = data[key];
  if (!d) {
    d = { tasks: [], clockIn: "", clockOut: "", submitted: false };
    data[key] = d;
  } else if (Array.isArray(d)) {
    d = { tasks: d, clockIn: "", clockOut: "", submitted: false };
    data[key] = d;
  } else {
    if (!d.tasks) d.tasks = [];
    if (typeof d.submitted !== "boolean") d.submitted = false;
  }
  // Normalize each task to the current shape, migrating older entries.
  d.tasks.forEach(t => {
    if (t.status === undefined) t.status = t.done ? "Resolved" : "Open";
    if (t.priority === undefined) t.priority = "Medium";
    if (t.ticket === undefined) t.ticket = "";
  });
  return d;
}

// Returns hours worked as a decimal, given "HH:MM" strings. Assumes a
// clock-out earlier than clock-in means the shift crossed midnight.
function calcHours(clockIn, clockOut) {
  if (!clockIn || !clockOut) return 0;
  const [h1, m1] = clockIn.split(":").map(Number);
  const [h2, m2] = clockOut.split(":").map(Number);
  let mins = (h2 * 60 + m2) - (h1 * 60 + m1);
  if (mins < 0) mins += 24 * 60;
  return mins / 60;
}
function fmtHours(hoursDecimal) {
  const h = Math.floor(hoursDecimal);
  const m = Math.round((hoursDecimal - h) * 60);
  return `${h}h ${m}m`;
}
function fmtMinutes(totalMinutes) {
  const h = Math.floor(totalMinutes / 60);
  const m = Math.round(totalMinutes % 60);
  return `${h}h ${m}m`;
}
function sumTaskMinutes(tasks) {
  return tasks.reduce((sum, t) => sum + (Number(t.minutes) || 0), 0);
}

let currentDate = new Date();
let data = loadData();

const taskInput = document.getElementById("taskInput");
const taskTicket = document.getElementById("taskTicket");
const taskCategory = document.getElementById("taskCategory");
const taskPriority = document.getElementById("taskPriority");
const addBtn = document.getElementById("addBtn");
const dayLabel = document.getElementById("dayLabel");
const taskList = document.getElementById("taskList");
const emptyMsg = document.getElementById("emptyMsg");
const prevDay = document.getElementById("prevDay");
const nextDay = document.getElementById("nextDay");
const jumpToday = document.getElementById("jumpToday");
const weekStartInput = document.getElementById("weekStart");
const previewWeekBtn = document.getElementById("previewWeek");
const exportPdfBtn = document.getElementById("exportPdf");
const weekPreview = document.getElementById("weekPreview");
const weekTotal = document.getElementById("weekTotal");
const clockInInput = document.getElementById("clockIn");
const clockOutInput = document.getElementById("clockOut");
const hoursBadge = document.getElementById("hoursBadge");
const clockInBtn = document.getElementById("clockInBtn");
const clockOutBtn = document.getElementById("clockOutBtn");
const submitDayBtn = document.getElementById("submitDayBtn");
const submitStatus = document.getElementById("submitStatus");
const taskMinutesInput = document.getElementById("taskMinutes");
const taskTimeBadge = document.getElementById("taskTimeBadge");

// ---- Theme (dark / light) ----
const THEME_KEY = "taskTrackerTheme";
const themeToggle = document.getElementById("themeToggle");
function applyTheme(t) {
  if (t === "dark") {
    document.documentElement.setAttribute("data-theme", "dark");
    themeToggle.textContent = "☀️";
  } else {
    document.documentElement.removeAttribute("data-theme");
    themeToggle.textContent = "🌙";
  }
}
let theme = localStorage.getItem(THEME_KEY) || "light";
applyTheme(theme);
themeToggle.addEventListener("click", () => {
  theme = theme === "dark" ? "light" : "dark";
  localStorage.setItem(THEME_KEY, theme);
  applyTheme(theme);
});

function currentTimeStr() {
  const now = new Date();
  return `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
}

function renderDay() {
  const key = fmtDate(currentDate);
  dayLabel.textContent = fmtLabel(currentDate);
  const day = getDayData(key);
  const entries = day.tasks;

  clockInInput.value = day.clockIn || "";
  clockOutInput.value = day.clockOut || "";
  hoursBadge.textContent = fmtHours(calcHours(day.clockIn, day.clockOut));

  const locked = !!day.submitted;
  clockInInput.disabled = locked;
  clockOutInput.disabled = locked;
  clockInBtn.disabled = locked;
  clockOutBtn.disabled = locked;

  if (locked) {
    submitDayBtn.textContent = "Submitted — Edit";
    submitDayBtn.classList.add("is-submitted");
    submitStatus.textContent = "✓ Submitted for this day";
    submitStatus.classList.add("show");
  } else {
    submitDayBtn.textContent = "Submit";
    submitDayBtn.classList.remove("is-submitted");
    submitStatus.classList.remove("show");
  }

  taskList.innerHTML = "";
  emptyMsg.style.display = entries.length ? "none" : "block";
  entries.forEach((entry, idx) => {
    const li = document.createElement("li");
    const statusSel = document.createElement("select");
    statusSel.className = "status-select";
    statusSel.dataset.status = entry.status;
    ["Open", "In Progress", "Resolved"].forEach(s => {
      const o = document.createElement("option");
      o.value = s;
      o.textContent = s;
      if (s === entry.status) o.selected = true;
      statusSel.appendChild(o);
    });
    statusSel.addEventListener("change", () => {
      entry.status = statusSel.value;
      entry.done = statusSel.value === "Resolved";
      saveData(data);
      renderDay();
    });
    const span = document.createElement("span");
    span.className = "task-text" + (entry.status === "Resolved" ? " done" : "");
    span.textContent = entry.text;
    const tag = document.createElement("span");
    tag.className = "tag";
    tag.dataset.cat = entry.category;
    tag.textContent = entry.category;
    const del = document.createElement("button");
    del.className = "btn-danger";
    del.textContent = "✕";
    del.addEventListener("click", () => {
      entries.splice(idx, 1);
      saveData(data);
      renderDay();
    });
    li.appendChild(statusSel);
    li.appendChild(span);
    if (entry.ticket) {
      const ticketBadge = document.createElement("span");
      ticketBadge.className = "ticket-badge";
      ticketBadge.textContent = "#" + entry.ticket;
      li.appendChild(ticketBadge);
    }
    if (entry.minutes) {
      const duration = document.createElement("span");
      duration.className = "duration-tag";
      duration.textContent = fmtMinutes(entry.minutes);
      li.appendChild(duration);
    }
    const prio = document.createElement("span");
    prio.className = "prio-tag";
    prio.dataset.prio = entry.priority;
    prio.textContent = entry.priority;
    li.appendChild(prio);
    li.appendChild(tag);
    li.appendChild(del);
    taskList.appendChild(li);
  });

  taskTimeBadge.textContent = `Task time: ${fmtMinutes(sumTaskMinutes(entries))}`;
}

function addTask() {
  const text = taskInput.value.trim();
  if (!text) return;
  const key = fmtDate(currentDate);
  const day = getDayData(key);
  const minutes = Math.max(0, Number(taskMinutesInput.value) || 0);
  day.tasks.push({
    text,
    ticket: taskTicket.value.trim(),
    category: taskCategory.value,
    priority: taskPriority.value,
    status: "Open",
    done: false,
    minutes,
  });
  saveData(data);
  taskInput.value = "";
  taskTicket.value = "";
  taskMinutesInput.value = "";
  renderDay();
}

addBtn.addEventListener("click", addTask);
taskInput.addEventListener("keydown", (e) => { if (e.key === "Enter") addTask(); });
taskTicket.addEventListener("keydown", (e) => { if (e.key === "Enter") addTask(); });
taskMinutesInput.addEventListener("keydown", (e) => { if (e.key === "Enter") addTask(); });

function saveClockTimes() {
  const key = fmtDate(currentDate);
  const day = getDayData(key);
  day.clockIn = clockInInput.value;
  day.clockOut = clockOutInput.value;
  saveData(data);
  hoursBadge.textContent = fmtHours(calcHours(day.clockIn, day.clockOut));
}
clockInInput.addEventListener("change", saveClockTimes);
clockOutInput.addEventListener("change", saveClockTimes);

clockInBtn.addEventListener("click", () => {
  clockInInput.value = currentTimeStr();
  saveClockTimes();
});
clockOutBtn.addEventListener("click", () => {
  clockOutInput.value = currentTimeStr();
  saveClockTimes();
});

submitDayBtn.addEventListener("click", () => {
  const key = fmtDate(currentDate);
  const day = getDayData(key);
  if (day.submitted) {
    day.submitted = false;
  } else {
    if (!day.clockIn || !day.clockOut) {
      alert("Please clock in and clock out before submitting.");
      return;
    }
    day.submitted = true;
  }
  saveData(data);
  renderDay();
});

prevDay.addEventListener("click", () => {
  currentDate.setDate(currentDate.getDate() - 1);
  renderDay();
});
nextDay.addEventListener("click", () => {
  currentDate.setDate(currentDate.getDate() + 1);
  renderDay();
});
jumpToday.addEventListener("click", () => {
  currentDate = new Date();
  renderDay();
});

function getMonday(d) {
  const date = new Date(d);
  const day = date.getDay();
  const diff = date.getDate() - day + (day === 0 ? -6 : 1);
  date.setDate(diff);
  date.setHours(0,0,0,0);
  return date;
}

function initWeekInput() {
  const monday = getMonday(new Date());
  weekStartInput.value = fmtDate(monday);
}
initWeekInput();

function buildWeekData(startDateStr) {
  const start = new Date(startDateStr + "T00:00:00");
  const days = [];
  for (let i = 0; i < 7; i++) {
    const d = new Date(start);
    d.setDate(start.getDate() + i);
    const key = fmtDate(d);
    const day = getDayData(key);
    days.push({
      date: d,
      key,
      entries: day.tasks,
      clockIn: day.clockIn,
      clockOut: day.clockOut,
      hours: calcHours(day.clockIn, day.clockOut),
      taskMinutes: sumTaskMinutes(day.tasks),
    });
  }
  return days;
}

function renderWeekPreview() {
  const startVal = weekStartInput.value;
  if (!startVal) return;
  const days = buildWeekData(startVal);
  weekPreview.innerHTML = "";
  let totalTasks = 0;
  let totalHours = 0;
  let totalTaskMinutes = 0;
  days.forEach(day => {
    totalTasks += day.entries.length;
    totalHours += day.hours;
    totalTaskMinutes += day.taskMinutes;
    const block = document.createElement("div");
    block.className = "day-block";
    const h3 = document.createElement("h3");
    h3.textContent = day.date.toLocaleDateString(undefined, { weekday: "long", month: "short", day: "numeric" });
    const hoursSpan = document.createElement("span");
    hoursSpan.className = "day-hours";
    hoursSpan.textContent = day.hours > 0 ? fmtHours(day.hours) : "—";
    h3.appendChild(hoursSpan);
    block.appendChild(h3);
    const clockLine = document.createElement("div");
    clockLine.className = "status";
    clockLine.style.marginBottom = "2px";
    clockLine.textContent = `Clock In: ${day.clockIn || "—"}   Clock Out: ${day.clockOut || "—"}`;
    block.appendChild(clockLine);
    const taskTimeLine = document.createElement("div");
    taskTimeLine.className = "status";
    taskTimeLine.style.marginBottom = "6px";
    taskTimeLine.textContent = `Task time logged: ${fmtMinutes(day.taskMinutes)}`;
    block.appendChild(taskTimeLine);
    if (day.entries.length === 0) {
      const p = document.createElement("div");
      p.className = "status";
      p.textContent = "No tasks logged";
      block.appendChild(p);
    } else {
      const ul = document.createElement("ul");
      day.entries.forEach(entry => {
        const li = document.createElement("li");
        const durationText = entry.minutes ? ` (${fmtMinutes(entry.minutes)})` : "";
        const sym = entry.status === "Resolved" ? "✓" : (entry.status === "In Progress" ? "◐" : "○");
        const ticketText = entry.ticket ? `#${entry.ticket} ` : "";
        li.textContent = `${sym} ${ticketText}[${entry.category}] ${entry.text}${durationText} — ${entry.priority}`;
        ul.appendChild(li);
      });
      block.appendChild(ul);
    }
    weekPreview.appendChild(block);
  });

  if (totalHours > 0 || totalTaskMinutes > 0) {
    weekTotal.style.display = "flex";
    weekTotal.innerHTML = `
      <div class="week-total-row"><span>Total hours worked (clock in/out)</span><span class="value">${fmtHours(totalHours)}</span></div>
      <div class="week-total-row"><span>Total time logged on tasks</span><span class="value">${fmtMinutes(totalTaskMinutes)}</span></div>
    `;
  } else {
    weekTotal.style.display = "none";
  }

  if (totalTasks === 0) {
    weekPreview.innerHTML = '<div class="empty">No tasks logged for this week yet.</div>';
  }
}

previewWeekBtn.addEventListener("click", renderWeekPreview);

exportPdfBtn.addEventListener("click", () => {
  const startVal = weekStartInput.value;
  if (!startVal) { alert("Pick a week start date first."); return; }
  const days = buildWeekData(startVal);
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: "pt", format: "a4" });

  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const marginX = 48;
  const contentWidth = pageWidth - marginX * 2;
  const weekEnd = new Date(days[6].date);
  const totalHours = days.reduce((sum, d) => sum + d.hours, 0);
  const totalTaskMinutes = days.reduce((sum, d) => sum + d.taskMinutes, 0);

  const PURPLE = [109, 91, 245];
  const PURPLE_SOFT = [239, 236, 255];
  const STRIPE = [247, 246, 253];
  const GRID = [225, 224, 240];
  const GRAY = [110, 110, 125];

  let y = 0;

  function ensureSpace(needed) {
    if (y + needed > pageHeight - 40) {
      doc.addPage();
      y = 44;
      doc.setFont("helvetica", "bold");
      doc.setFontSize(9);
      doc.setTextColor(...GRAY);
      doc.text("Weekly Work Report — continued", marginX, y);
      doc.setTextColor(0);
      y += 20;
    }
  }

  // ---- Header banner ----
  doc.setFillColor(...PURPLE);
  doc.rect(0, 0, pageWidth, 74, "F");
  doc.setTextColor(255);
  doc.setFont("helvetica", "bold");
  doc.setFontSize(18);
  doc.text("Weekly Work Report", marginX, 34);
  doc.setFont("helvetica", "normal");
  doc.setFontSize(10);
  doc.text(`${days[0].date.toDateString()} — ${weekEnd.toDateString()}`, marginX, 52);
  doc.setFont("helvetica", "bold");
  doc.setFontSize(11.5);
  doc.text("TechSquad LLC", pageWidth - marginX, 28, { align: "right" });
  doc.setFont("helvetica", "bold");
  doc.setFontSize(9.5);
  doc.text("Manish Kumar Sabbani", pageWidth - marginX, 44, { align: "right" });
  doc.setFont("helvetica", "normal");
  doc.setFontSize(8.5);
  doc.text("Technical Support Analyst", pageWidth - marginX, 57, { align: "right" });
  doc.setTextColor(0);
  y = 100;

  // ---- Summary cards ----
  const cardGap = 16;
  const cardW = (contentWidth - cardGap) / 2;
  const cardH = 52;
  [
    { label: "TOTAL HOURS WORKED", value: fmtHours(totalHours), x: marginX },
    { label: "TOTAL TASK TIME LOGGED", value: fmtMinutes(totalTaskMinutes), x: marginX + cardW + cardGap },
  ].forEach(card => {
    doc.setFillColor(...PURPLE_SOFT);
    doc.roundedRect(card.x, y, cardW, cardH, 6, 6, "F");
    doc.setTextColor(90, 72, 224);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(8.5);
    doc.text(card.label, card.x + 14, y + 20);
    doc.setFontSize(19);
    doc.text(card.value, card.x + 14, y + 40);
  });
  doc.setTextColor(0);
  y += cardH + 22;

  // ---- Attendance summary table ----
  ensureSpace(24 + (days.length + 1) * 20);
  doc.setFont("helvetica", "bold");
  doc.setFontSize(12);
  doc.text("Attendance Summary", marginX, y);
  y += 14;

  const colFractions = [0.27, 0.19, 0.19, 0.175, 0.175];
  const colWidths = colFractions.map(f => contentWidth * f);
  const headers = ["Day", "Clock In", "Clock Out", "Att. Hours", "Task Time"];
  const rowH = 22;

  function tableRow(cells, opts) {
    opts = opts || {};
    ensureSpace(rowH);
    let x = marginX;
    doc.setFont("helvetica", opts.header ? "bold" : "normal");
    doc.setFontSize(9.5);
    cells.forEach((cellText, i) => {
      const w = colWidths[i];
      if (opts.header) {
        doc.setFillColor(...PURPLE);
      } else if (opts.stripe) {
        doc.setFillColor(...STRIPE);
      } else {
        doc.setFillColor(255, 255, 255);
      }
      doc.rect(x, y, w, rowH, "F");
      doc.setDrawColor(...GRID);
      doc.setLineWidth(0.5);
      doc.rect(x, y, w, rowH, "S");
      doc.setTextColor(opts.header ? 255 : 20);
      doc.text(String(cellText), x + 8, y + 14.5);
      x += w;
    });
    doc.setTextColor(0);
    y += rowH;
  }

  tableRow(headers, { header: true });
  days.forEach((day, i) => {
    tableRow([
      day.date.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" }),
      day.clockIn || "—",
      day.clockOut || "—",
      day.hours > 0 ? fmtHours(day.hours) : "—",
      day.taskMinutes > 0 ? fmtMinutes(day.taskMinutes) : "—",
    ], { stripe: i % 2 === 0 });
  });
  y += 22;

  // ---- Daily task details ----
  ensureSpace(22);
  doc.setFont("helvetica", "bold");
  doc.setFontSize(12);
  doc.text("Daily Task Details", marginX, y);
  y += 14;

  days.forEach((day, idx) => {
    ensureSpace(30);

    doc.setFillColor(...STRIPE);
    doc.rect(marginX, y, contentWidth, 20, "F");
    doc.setFont("helvetica", "bold");
    doc.setFontSize(10.5);
    doc.setTextColor(90, 72, 224);
    const heading = day.date.toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" });
    doc.text(heading, marginX + 8, y + 14);

    doc.setFont("helvetica", "normal");
    doc.setFontSize(8.5);
    doc.setTextColor(...GRAY);
    const info = `In ${day.clockIn || "—"}  •  Out ${day.clockOut || "—"}  •  ${day.hours > 0 ? fmtHours(day.hours) : "0h 0m"} worked  •  ${fmtMinutes(day.taskMinutes)} logged`;
    doc.text(info, marginX + contentWidth - 8, y + 14, { align: "right" });
    doc.setTextColor(0);
    y += 28;

    if (day.entries.length === 0) {
      doc.setFont("helvetica", "italic");
      doc.setFontSize(9.5);
      doc.setTextColor(150);
      doc.text("No tasks logged", marginX + 14, y);
      doc.setTextColor(0);
      y += 18;
    } else {
      doc.setFont("helvetica", "normal");
      doc.setFontSize(9.5);
      day.entries.forEach(entry => {
        const durationText = entry.minutes ? `  (${fmtMinutes(entry.minutes)})` : "";
        const ticketText = entry.ticket ? `#${entry.ticket}  ` : "";
        const statusText = entry.status && entry.status !== "Resolved" ? `  ·  ${entry.status}` : "";
        const raw = `${ticketText}[${entry.category}] ${entry.text}${durationText}  ·  ${entry.priority}${statusText}`;
        const wrapped = doc.splitTextToSize(raw, contentWidth - 78);
        wrapped.forEach((line, i) => {
          ensureSpace(16);
          if (i === 0) {
            // Draw a small status glyph instead of a unicode checkmark, which
            // Helvetica's standard PDF encoding does not reliably render.
            const boxSize = 8;
            const boxX = marginX + 14;
            const boxY = y - boxSize + 1;
            if (entry.status === "Resolved") {
              doc.setFillColor(23, 166, 115);
              doc.roundedRect(boxX, boxY, boxSize, boxSize, 1.5, 1.5, "F");
              doc.setDrawColor(255, 255, 255);
              doc.setLineWidth(1);
              doc.line(boxX + 1.6, boxY + 4.4, boxX + 3.3, boxY + 6.2);
              doc.line(boxX + 3.3, boxY + 6.2, boxX + 6.6, boxY + 2);
            } else if (entry.status === "In Progress") {
              doc.setDrawColor(181, 101, 10);
              doc.setLineWidth(1);
              doc.roundedRect(boxX, boxY, boxSize, boxSize, 1.5, 1.5, "S");
              doc.setFillColor(181, 101, 10);
              doc.circle(boxX + boxSize / 2, boxY + boxSize / 2, 1.6, "F");
            } else {
              doc.setDrawColor(190, 190, 208);
              doc.setLineWidth(1);
              doc.roundedRect(boxX, boxY, boxSize, boxSize, 1.5, 1.5, "S");
            }
          }
          doc.setTextColor(20);
          doc.text(line, marginX + 30, y);
          y += 15;
        });
      });
    }
    y += 9;

    if (idx < days.length - 1) {
      doc.setDrawColor(...GRID);
      doc.setLineWidth(0.5);
      doc.line(marginX, y - 4, marginX + contentWidth, y - 4);
      y += 4;
    }
  });

  // ---- Footer page numbers ----
  const pageCount = doc.internal.getNumberOfPages();
  for (let p = 1; p <= pageCount; p++) {
    doc.setPage(p);
    doc.setFont("helvetica", "normal");
    doc.setFontSize(8);
    doc.setTextColor(150);
    doc.text(`Page ${p} of ${pageCount}`, pageWidth / 2, pageHeight - 24, { align: "center" });
    doc.setTextColor(0);
  }

  const filename = `Weekly_Report_${days[0].key}_to_${days[6].key}.pdf`;
  doc.save(filename);
});

// ---- Data backup & auto-save to file ----
const saveIndicator = document.getElementById("saveIndicator");
const saveFileBtn = document.getElementById("saveFileBtn");
const loadFileBtn = document.getElementById("loadFileBtn");
const importInput = document.getElementById("importInput");
const autosaveRow = document.getElementById("autosaveRow");
const linkFileBtn = document.getElementById("linkFileBtn");
const autosaveStatus = document.getElementById("autosaveStatus");

let fileHandle = null;    // active handle we auto-save into
let storedHandle = null;  // remembered handle awaiting a permission re-grant
let fileSaveTimer = null;

function showSaved() {
  if (!saveIndicator) return;
  const t = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
  saveIndicator.textContent = "✓ Saved " + t;
  saveIndicator.classList.add("show");
}

function currentExport() {
  return JSON.stringify(
    { app: "DailyWorkReportTracker", version: 2, exportedAt: new Date().toISOString(), entries: data },
    null, 2
  );
}

function setAutosave(on, text) {
  if (!autosaveStatus) return;
  autosaveStatus.textContent = text;
  autosaveStatus.classList.toggle("on", on);
}

// Minimal IndexedDB key/value store, used to remember the linked file handle.
function idbSet(key, val) {
  return new Promise((res, rej) => {
    const open = indexedDB.open("ttBackup", 1);
    open.onupgradeneeded = () => open.result.createObjectStore("kv");
    open.onsuccess = () => {
      const tx = open.result.transaction("kv", "readwrite");
      tx.objectStore("kv").put(val, key);
      tx.oncomplete = () => { open.result.close(); res(); };
      tx.onerror = () => rej(tx.error);
    };
    open.onerror = () => rej(open.error);
  });
}
function idbGet(key) {
  return new Promise((res, rej) => {
    const open = indexedDB.open("ttBackup", 1);
    open.onupgradeneeded = () => open.result.createObjectStore("kv");
    open.onsuccess = () => {
      const tx = open.result.transaction("kv", "readonly");
      const rq = tx.objectStore("kv").get(key);
      rq.onsuccess = () => { const v = rq.result; open.result.close(); res(v); };
      rq.onerror = () => rej(rq.error);
    };
    open.onerror = () => rej(open.error);
  });
}

async function writeToLinkedFile() {
  if (!fileHandle) return;
  try {
    if ((await fileHandle.queryPermission({ mode: "readwrite" })) !== "granted") {
      storedHandle = fileHandle;
      fileHandle = null;
      linkFileBtn.textContent = "Reconnect auto-save";
      setAutosave(false, "Auto-save paused — click Reconnect");
      return;
    }
    const w = await fileHandle.createWritable();
    await w.write(currentExport());
    await w.close();
    setAutosave(true, "Auto-saving to " + fileHandle.name);
  } catch (e) {
    setAutosave(false, "Auto-save error — click Reconnect");
  }
}

// Debounced: called on every saveData() so rapid edits collapse into one write.
function scheduleFileSave() {
  if (!fileHandle) return;
  clearTimeout(fileSaveTimer);
  fileSaveTimer = setTimeout(writeToLinkedFile, 600);
}

function downloadJson(json) {
  const blob = new Blob([json], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `task-tracker-backup-${fmtDate(new Date())}.json`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

// Save backup file: use the file picker when available (lets you overwrite the
// same OneDrive file each week), otherwise fall back to a normal download.
saveFileBtn.addEventListener("click", async () => {
  const json = currentExport();
  if (window.showSaveFilePicker) {
    try {
      const handle = await window.showSaveFilePicker({
        suggestedName: `task-tracker-backup-${fmtDate(new Date())}.json`,
        types: [{ description: "JSON backup", accept: { "application/json": [".json"] } }],
      });
      const w = await handle.createWritable();
      await w.write(json);
      await w.close();
      showSaved();
      return;
    } catch (e) {
      if (e.name === "AbortError") return; // user cancelled
    }
  }
  downloadJson(json);
});

loadFileBtn.addEventListener("click", () => importInput.click());
importInput.addEventListener("change", () => {
  const file = importInput.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const parsed = JSON.parse(reader.result);
      const entries = parsed && parsed.entries ? parsed.entries : parsed;
      if (!entries || typeof entries !== "object") throw new Error("bad shape");
      if (!confirm("Restore this backup? It will replace the data currently in this browser.")) {
        importInput.value = "";
        return;
      }
      data = entries;
      saveData(data);
      renderDay();
      renderWeekPreview();
      alert("Backup restored successfully.");
    } catch (e) {
      alert("Sorry, that file could not be read as a valid backup.");
    }
    importInput.value = "";
  };
  reader.readAsText(file);
});

// Auto-save-to-file (File System Access API) — progressive enhancement.
if ("showSaveFilePicker" in window) {
  autosaveRow.hidden = false;
  idbGet("fileHandle").then(async (h) => {
    if (!h) { setAutosave(false, "Auto-save off"); return; }
    try {
      if ((await h.queryPermission({ mode: "readwrite" })) === "granted") {
        fileHandle = h;
        linkFileBtn.textContent = "Change auto-save file";
        setAutosave(true, "Auto-saving to " + h.name);
      } else {
        storedHandle = h;
        linkFileBtn.textContent = "Reconnect auto-save";
        setAutosave(false, "Click Reconnect to resume auto-save");
      }
    } catch (e) {
      setAutosave(false, "Auto-save off");
    }
  }).catch(() => setAutosave(false, "Auto-save off"));

  linkFileBtn.addEventListener("click", async () => {
    try {
      // Reconnecting a remembered file only needs a permission re-grant.
      if (storedHandle && !fileHandle) {
        if ((await storedHandle.requestPermission({ mode: "readwrite" })) === "granted") {
          fileHandle = storedHandle;
          storedHandle = null;
          linkFileBtn.textContent = "Change auto-save file";
          await writeToLinkedFile();
          return;
        }
      }
      // Otherwise pick/create the file to auto-save into.
      const handle = await window.showSaveFilePicker({
        suggestedName: "task-tracker-data.json",
        types: [{ description: "JSON data", accept: { "application/json": [".json"] } }],
      });
      fileHandle = handle;
      storedHandle = null;
      await idbSet("fileHandle", handle);
      linkFileBtn.textContent = "Change auto-save file";
      await writeToLinkedFile();
    } catch (e) {
      if (e.name !== "AbortError") setAutosave(false, "Could not link file on this browser");
    }
  });
}

renderDay();
renderWeekPreview();
</script>
